# Variables del bot. En Render se cargan en el panel del servicio (Environment).
# Para probar en la PC: copiá este archivo como whatsapp_bot/.env (nunca se sube a GitHub).
# Los datos de la tienda los toma solos de tiendanube/.env si existe.

# --- Tienda online (Tiendanube): de acá saca productos, precios y stock ---
TIENDANUBE_STORE_ID=1578148
TIENDANUBE_TOKEN=
TIENDANUBE_EMAIL=

# --- Claude (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
# MODELO=claude-opus-5-5
# ESFUERZO=medium

# --- WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → Configuración de la API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inventá una clave cualquiera y poné la misma en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# Clave secreta de la app de Meta (Configuración de la app → Básica)
META_APP_SECRET=

# --- Opcionales ---
# Tu WhatsApp personal para recibir avisos de clientes derivados (549 + área + número)
OWNER_PHONE=
PAUSA_HORAS=12
# Poné 1 solo mientras usás el número de prueba de Meta con celulares argentinos
AR_QUITAR_9=0
